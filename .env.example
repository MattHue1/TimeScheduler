# Required for requests sent by Hermes to this service.
TIMESCHEDULER_API_KEY=replace-with-a-long-random-secret

# Hermes Agent OpenAI-compatible API (used by /api/v1/hermes/import).
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# Google Calendar OAuth files and destination calendar.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary

# Local service settings.
DATABASE_PATH=data/timescheduler.db
TIMESCHEDULER_HOST=127.0.0.1
TIMESCHEDULER_PORT=8081
DEFAULT_TIMEZONE=America/Toronto
DEFAULT_REMINDERS_MINUTES=30,10
